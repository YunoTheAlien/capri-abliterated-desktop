    },
    {
     "count": 1,
     "find": "    public Control Options()\n    {\n",
     "op": "replace",
     "with": "    private bool togglesMade;\n\n    public Control Options()\n    {\n"
    },
    {
     "from": "        Action<string, bool, Action<bool>> check = delegate",
