  "capriplus-lyrics": {
   "file": "capriplus-lyrics.capri-code",
   "result": "d1e1754f22356d0362c9096e8a50b5d4dec8bed11868c927914a9668b50a7784",
   "rewritten": true,
   "sha256": "f7df27caa4b18917959fea68cfe310e8570fa1f904dd7f63e8a02bae2cd4997e",
   "steps": [
    {
     "count": 1,
     "find": "internal const string Agent = \"CapriPlus-Lyrics/1.0.0 (unofficial Capri community mod; https://github.com/lachydotmcg/capri-mods)\";",
     "op": "replace",
     "with": "internal const string Agent = \"CapriPlus-Lyrics/1.0.0\";"
    },
    {
     "allow": [
      "lrclib.net"
     ],
     "op": "comment-links"
    },
    {
     "op": "permissions",
     "set": "music"
    },
    {
     "count": 1,
     "find": "            host.Ui.SetOptions(\"Capri+ Lyrics\", MakeOptions);\n",
     "op": "replace",
     "with": "            MakeOptions().Dispose();\n            host.Ui.SetOptions(\"Capri+ Lyrics\", MakeOptions);\n"
    },
    {
     "count": 1,
     "find": "        private Control MakeOptions()\n",
     "op": "replace",
     "with": "        private bool togglesMade;\n\n        private Control MakeOptions()\n"
    },
    {
     "from": "            Func<string, bool, Action<bool>, CheckBox> check = delegate",
     "op": "cut",
     "to": "            check(\"Show lyrics\"",
     "with": "            Func<string, bool, Action<bool>, CheckBox> check = delegate(string text, bool on, Action<bool> changed)\n            {\n                if (!togglesMade) capri.Toggles.Add(text, on, delegate(bool now) { changed(now); Saved(); });\n                return null;\n            };\n            Func<string, int, int, int, int, Func<int, string>, Action<int>, TrackBar> slider = delegate(string text, int min, int max, int step, int value, Func<int, string> show, Action<int> changed)\n            {\n                if (togglesMade) return null;\n                // Her Toggles sliders hold 21 steps at most, so a finer one takes every few.\n                int wide = step * Math.Max(1, ((max - min) / step + 21) / 21);\n                List<string> steps = new List<string>();\n                for (int v = min; v <= max; v += wide) steps.Add(show(v));\n                capri.Toggles.AddSlider(text, steps.ToArray(), Math.Min(steps.Count - 1, (Math.Max(min, Math.Min(max, value)) - min + wide / 2) / wide), delegate(int at) { changed(min + at * wide); Saved(); });\n                return null;\n            };\n"
    },
    {
     "count": 1,
     "find": "            Button clear = new Button { Text = \"Forget saved lyrics\"",
     "op": "replace",
     "with": "            togglesMade = true;\n            Button clear = new Button { Text = \"Forget saved lyrics\""
    }
   ],
   "toggles": [
    "its options window's ticks and sliders as Toggles.Add and Toggles.AddSlider, one each"
   ],
   "verdict": "adapted",
   "version": "1.0.0"
  },
