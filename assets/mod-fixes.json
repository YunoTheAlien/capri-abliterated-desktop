     "with": "        Action<string, bool, Action<bool>> check = delegate(string text, bool on, Action<bool> set)\n        {\n            if (!togglesMade) host.Toggles.Add(text, on, delegate(bool now) { set(now); settings.Save(host.Store); Recolour(); });\n        };\n"
    },
    {
     "from": "        Label sizeLabel = new Label",
     "op": "cut",
     "to": "        Label keys = new Label",
     "with": "        if (!togglesMade)\n        {\n            string[] sizes = { \"80%\", \"90%\", \"100%\", \"110%\", \"120%\", \"130%\", \"140%\" };\n            host.Toggles.AddSlider(\"Size\", sizes, Math.Max(0, Math.Min(6, (int)Math.Round((settings.Size * 100 - 80) / 10))), delegate(int at) { settings.Size = (80 + at * 10) / 100.0; settings.Save(host.Store); layerKey = null; });\n            host.Toggles.AddSlider(\"Mode\", new[] { \"Full\", \"Mini\" }, mode == Mini ? 1 : 0, delegate(int at) { SetMode(at == 1 ? Mini : Full); });\n        }\n        togglesMade = true;\n"
    }
   ],
