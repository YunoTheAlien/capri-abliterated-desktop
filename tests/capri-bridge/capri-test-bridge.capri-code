// capri-mod: 1
// id: capri-test-bridge
// name: Test Bridge
// version: 1.0.0
// author: Capri tests
// description: For testing only. Lets a script on this PC type to her and read back her replies and the tools she uses. Remove it when testing is done.
// permissions: chat, tools
// requires: api 3

// How it works: tests/capri-bridge/capri-say drops a text file into this mod's data folder, under "in". Every quarter
// second the mod hands each one to her through Chat.Send, the same as if it was typed, and deletes it. What she hears,
// says and does is appended to "out.jsonl", one JSON object a line. "alive" holds the Unix time of a recent tick, so the
// script can tell the mod is running. Nothing leaves the PC. Chat.Send never answers her asking first, so a tool she
// has to check with you still waits for your own yes.

using System;
using System.IO;
using System.Text;
using CapriDesktop;

public class CapriTestBridge : ICapriMod
{
    private ICapriHost capri;
    private string inbox;
    private string outFile;
    private string aliveFile;
    private bool wasBusy;
    private bool replied;
    private int ticks;

    public void Start(ICapriHost host)
    {
        capri = host;
        inbox = Path.Combine(host.Folder, "in");
        outFile = Path.Combine(host.Folder, "out.jsonl");
        aliveFile = Path.Combine(host.Folder, "alive");
        Directory.CreateDirectory(inbox);
        capri.Chat.Sending += delegate(CapriMessage m) { Write("heard", m.Source, m.Text); };
        capri.Chat.Replied += delegate(CapriMessage m) { Write("said", m.Source, m.Text); replied = true; };
        capri.Chat.ToolUsing += delegate(CapriToolCall call) { Write("tool", call.Tool, call.Doing); };
        capri.Chat.ToolUsed += delegate(string tool, string result) { Write("tool-done", tool, result); };
        capri.Timers.Every(0.25, Tick);
        Write("started", "", capri.CapriVersion);
        Tick();
    }

    public bool Heard(string words) { return false; }

    public void Stop() { Write("stopped", "", ""); }

    private void Tick()
    {
        // "idle" is written when she stops being busy, and after each reply once she's quiet, so a script waiting on its
        // answer always sees one.
        bool busy = capri.Chat.Busy;
        if (busy != wasBusy || (replied && !busy)) Write(busy ? "busy" : "idle", "", "");
        if (!busy) replied = false;
        wasBusy = busy;
        if (ticks++ % 4 == 0) Try(delegate { File.WriteAllText(aliveFile, ((long)(DateTime.UtcNow - new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc)).TotalSeconds).ToString()); });
        string[] waiting;
        try { waiting = Directory.GetFiles(inbox, "*.txt"); }
        catch (IOException) { return; }
        Array.Sort(waiting, StringComparer.Ordinal);
        foreach (string file in waiting)
        {
            string text = null;
            try { text = File.ReadAllText(file).Trim(); File.Delete(file); }
            catch (IOException) { continue; }
            catch (UnauthorizedAccessException) { continue; }
            if (text.Length == 0) continue;
            Write("send", Path.GetFileNameWithoutExtension(file), text);
            capri.Chat.Send(text);
        }
    }

    private void Write(string kind, string about, string text)
    {
        string line = "{\"at\":\"" + DateTime.UtcNow.ToString("o") + "\",\"kind\":" + Json(kind) + ",\"about\":" + Json(about) + ",\"text\":" + Json(text) + "}\n";
        Try(delegate { File.AppendAllText(outFile, line); });
    }

    private void Try(Action write)
    {
        try { write(); }
        catch (IOException) { }
        catch (UnauthorizedAccessException) { }
    }

    private static string Json(string value)
    {
        StringBuilder made = new StringBuilder("\"");
        foreach (char c in value ?? "")
        {
            if (c == '"' || c == '\\') made.Append('\\').Append(c);
            else if (c < ' ') made.Append("\\u").Append(((int)c).ToString("x4"));
            else made.Append(c);
        }
        return made.Append('"').ToString();
    }
}
